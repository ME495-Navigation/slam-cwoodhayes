<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- this node only exists on the turtlebot itself. no need to depend on it; we won't use this arg on another machine -->
  <node pkg="numsr_turtlebot" exec="numsr_turtlebot"></node>

  <!-- lidar -->
  <node pkg="hls_lfcd_lds_driver" exec="hlds_laser_publisher" output="screen">
    <param name="frame_id" value="green/base_scan"/>
    <param name="port" value="/dev/ttyUSB0"/>
  </node>

  <!-- constants -->
  <let name="diff_params" value="$(find-pkg-share nuturtle_description)/config/diff_params.yaml"/>
  <let name="slam_params" value="$(find-pkg-share nuslam)/config/slam_irl_config.yaml"/>
  <let name="world_config" value="$(find-pkg-share nuslam)/config/slam_irl_arena.yaml"/>

  <!-- stuff from start_robot.launch.xml -->
  <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
      <arg name="use_rviz" value="false"/>
      <arg name="color" value="blue"/>
      <arg name="use_jsp" value="false"/>
  </include>
  <!-- run nusim but only draw the landmarks -->
  <node pkg="nusim" exec="nusim"  name="nuwalls" output="screen">>
      <param name="draw_only" value="true"/>
      <param from="$(var world_config)"/>
      <param name="world_frame" value="map"/>
  </node>
  <!-- green robot for SLAM robot estimate -->
  <include file="$(find-pkg-share nuturtle_description)/launch/load_one.launch.xml">
      <arg name="use_rviz" value="false"/>
      <arg name="color" value="green"/>
      <arg name="use_jsp" value="false"/>
  </include>

  <!-- robot-specific stuff -->
  <node pkg="nuslam" exec="slam_node" name="nuslam_node" output="screen">
    <param from="$(var diff_params)"/>
    <param from="$(var slam_params)"/>
    <param from="$(var world_config)"/>
    <param name="wheel_left" value="wheel_left_joint"/>
    <param name="wheel_right" value="wheel_right_joint"/>
    <param name="body_id" value="blue/base_footprint"/>
    <param name="odom_id" value="odom"/>
    <remap from="joint_states" to="blue/joint_states"/>
    <!-- additional params (different from odometry node) -->
    <param name="slam_body_id" value="green/base_footprint"/>
    <param name="landmark_observations_topic" value="/detected_obstacles"/>
    <!-- NEW PARAM TO ENABLE MAHALANOBIS-BASED ASSOCIATION IN SLAM UPDATES -->
    <param name="slam_mahalanobis_association" value="true"/> 
  </node>

  <!-- also launch landmark detection node.
       The real robot publishes on /scan; remap so the node can find it. -->
  <node pkg="nuslam" exec="landmarks" name="landmarks" output="screen">
    <param from="$(var world_config)"/>
    <param from="$(var slam_params)"/>
    <remap from="landmarks" to="/detected_obstacles"/>
    <remap from="red/scan" to="/scan"/>
    <param name="robot_frame" value="green/base_link"/>
  </node>

  <let name="diff_params" value="$(find-pkg-share nuturtle_description)/config/diff_params.yaml"/>
  <node pkg="turtle_control" exec="turtle_control_node" name="turtle_control" output="screen"
    on_exit="shutdown">
    <param from="$(var diff_params)"/>
    <remap from="joint_states" to="blue/joint_states"/>
  </node>

</launch> 
