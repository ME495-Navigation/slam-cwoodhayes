<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- args -->
  <arg name="robot" default="nusim" description="what robot to control (sim vs hardware etc)">
    <choice value="nusim"/>
    <choice value="localhost"/>
    <choice value="none"/>
  </arg>
  <arg name="cmd_src" default="teleop" description="Source of cmd_vel commands">
    <choice value="circle"/>
    <choice value="teleop"/>
    <choice value="none"/>
  </arg>

  <!-- launch normal SLAM nodes -->
  <include file="$(find-pkg-share nuslam)/launch/slam.launch.xml">
    <arg name="robot" value="$(var robot)"/>
    <arg name="cmd_src" value="$(var cmd_src)"/>
    <arg name="use_rviz" value="false"/>
  </include>

  <!-- also launch landmark detection node -->
  <node pkg="nuslam" exec="landmarks" name="landmarks" output="screen">
    <param from="$(find-pkg-share nuslam)/config/slam_demo_world.yaml"/>
    <param from="$(find-pkg-share nuslam)/config/slam_config.yaml"/>
    <remap from="landmarks" to="/detected_obstacles"/>
    <param name="robot_frame" value="red/base_link"/>
  </node>

  <let name="rviz_config" value="$(find-pkg-share nuslam)/config/landmarks.rviz"/>
  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"
      on_exit="shutdown"
      args="-d $(var rviz_config)"
      />
    

</launch>